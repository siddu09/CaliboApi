<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Calibo API Automation Suite"
       verbose="2"
       parallel="false">

    <parameter name="environment" value="qa"/>
    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="true"/>

    <test name="Calibo API Tests">
        <classes>
            <class name="tests.UsersTests"/>
            <class name="tests.PortfolioProductFeatureTests"/>
            <class name="tests.DataIngestionTests"/>
            <class name="tests.DevStageTests"/>
        </classes>
    </test>

</suite>
