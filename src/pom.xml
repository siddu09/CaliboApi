
<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.calibo.automation</groupId>
    <artifactId>calibo-api-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Calibo API Automation Framework</name>
    <description>Enterprise API Automation Framework using Java, TestNG and Rest Assured</description>

    <properties>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <playwright.version>1.44.0</playwright.version>
        <restassured.version>5.5.5</restassured.version>
        <testng.version>7.11.0</testng.version>
        <json.simple.version>1.1.1</json.simple.version>

    </properties>

    <dependencies>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Playwright browser automation for login and token capture -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- Rest Assured -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${restassured.version}</version>
        </dependency>

        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-path</artifactId>
            <version>${restassured.version}</version>
        </dependency>

        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>xml-path</artifactId>
            <version>${restassured.version}</version>
        </dependency>

        <!-- JSON Simple -->
        <dependency>
            <groupId>com.googlecode.json-simple</groupId>
            <artifactId>json-simple</artifactId>
            <version>${json.simple.version}</version>
        </dependency>

    </dependencies>

    <build>

        <sourceDirectory>.</sourceDirectory>

        <testSourceDirectory>java</testSourceDirectory>

        <testResources>
            <testResource>
                <directory>resources</directory>
                <targetPath>resources</targetPath>
            </testResource>
        </testResources>

        <plugins>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-devsecops-tests</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>add-test-source</goal></goals>
                        <configuration><sources><source>test</source></sources></configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Java Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>21</release>
                    <excludes>
                        <exclude>java/**</exclude>
                        <exclude>Main.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- TestNG -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>

                <configuration>

                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>

                    <systemPropertyVariables>

                        <environment>${environment}</environment>

                        <headless>${headless}</headless>

                    </systemPropertyVariables>

                </configuration>

            </plugin>

        </plugins>

    </build>

    <profiles>

        <profile>

            <id>qa</id>

            <properties>

                <environment>qa</environment>

                <headless>true</headless>

            </properties>

        </profile>

        <profile>

            <id>stage</id>

            <properties>

                <environment>stage</environment>

                <headless>true</headless>

            </properties>

        </profile>

        <profile>

            <id>local</id>

            <properties>

                <environment>local</environment>

                <headless>false</headless>

            </properties>

        </profile>

    </profiles>

</project>
