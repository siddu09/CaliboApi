private static void loadJson() {

  JSONObject json =
  JsonUtils.readJson("users.json");

  UserContext.createUserRequest =
  JsonPath.from(json.toJSONString())
  .getObject("userInput.users[0]", JSONObject.class);

  UserContext.updateUserRequest =
  JsonPath.from(json.toJSONString())
  .getObject("userEdit", JSONObject.class);

  UserContext.searchCriteria =
  JsonPath.from(json.toJSONString())
  .getObject("searchCriteria", JSONObject.class);

  UserContext.assignRoleRequest =
  JsonPath.from(json.toJSONString())
  .getObject("assignSelectedRoleInput", JSONObject.class);

}