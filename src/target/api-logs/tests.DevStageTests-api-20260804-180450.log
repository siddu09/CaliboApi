         \"command\": \"./gradlew build -- refresh-dependencies\",\n          \"component\": \"tools\"\n        }\n      ]\n    },\n    {\n      \"name\": \"run webapp\",\n      \"actions\": [\n        {\n          \"workdir\": \"${CHE_PROJECTS_ROOT}/project_name/build/libs/\",\n          \"type\": \"exec\",\n          \"command\": \"java -jar *.jar\",\n          \"component\": \"tools\"\n        }\n      ]\n    }\n  ]\n}"
