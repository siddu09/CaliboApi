           ]         },         {             \"name\": \"start\",             \"actions\": [                 {                     \"workdir\": \"${CHE_PROJECTS_ROOT}/project_name\",                     \"type\": \"exec\",                     \"command\": \"python3 -m uvicorn app.main:app --reload\",                     \"component\": \"python\"                 }             ]         },         {             \"name\": \"tasks\",             \"actions\": [                 {                     \"workdir\": \"${CHE_PROJECTS_ROOT}/project_name\",                     \"type\": \"exec\",                     \"command\": \"python3 main.py\",                     \"component\": \"python\"                 }             ]         }     ] }"
